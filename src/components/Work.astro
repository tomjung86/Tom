---
import Section from "./Section.astro";

type Offer = {
  title: string;
  description: string;
  bullets: string[];
  ctaText: string;
  ctaHref: string;
  chips?: string[];
};

interface Props {
  work: {
    heading?: string;
    intro?: string;
    offers: Offer[];
    email?: string;
  };
}

const { work } = Astro.props;
---

<Section text="Work" href="work">
  <div class="mx-auto max-w-2xl">
    <h3 class="font-serif text-2xl font-bold tracking-tightest text-white md:text-3xl">
      {work.heading ?? "Work with me"}
    </h3>

    {work.intro && (
      <p class="mt-4 text-base leading-relaxed text-neutral md:text-lg">
        {work.intro}
      </p>
    )}

    {work.offers && work.offers.length > 0 && (
      <div class="mt-8">
        <h4 class="text-sm font-medium tracking-wide text-primary/90">
          What I help fix
        </h4>

        <ul class="mt-4 list-none">
          {work.offers.map((o) => (
            <li class="relative mb-3 pl-8 text-base text-neutral before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
              {o.title}
            </li>
          ))}
        </ul>
      </div>
    )}

    {work.email && (
      <div class="mt-10">
        <a
          class="inline-block rounded-full bg-primary px-8 py-5 text-sm font-medium leading-5 text-[#fff]"
          href={`mailto:${work.email}`}
        >
          Email Tom
        </a>
      </div>
    )}
  </div>
</Section>
