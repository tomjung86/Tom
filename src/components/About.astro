---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;
---

<Section text="About" href="about">
  <div class="grid gap-10 md:grid-cols-12 md:gap-12">
    <div class="md:col-span-7">
      <div class="max-w-prose">
        <p class="text-sm font-medium tracking-wide text-primary/90">
          P&L Leadership · Scaling Operations · Strategic Execution
        </p>

        <h3 class="mt-3 font-serif text-2xl font-bold tracking-tightest text-white md:text-3xl">
        Structure for ambitious growth
        </h3>

        <div class="mt-5 space-y-4 text-base leading-relaxed text-neutral md:text-lg">
          <p class="whitespace-pre-line">{description}</p>
        </div>

        <div class="mt-7 flex flex-wrap gap-2">
          <span class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-neutral ring-1 ring-white/10">
            Alignment
          </span>
          <span class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-neutral ring-1 ring-white/10">
            Accountability
          </span>
          <span class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-neutral ring-1 ring-white/10">
            Clarity
          </span>
          <span class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-neutral ring-1 ring-white/10">
            Ownership
          </span>
        </div>
      </div>
    </div>

    <div class="md:col-span-5 md:flex md:justify-end">
      <figure class="w-full max-w-[18rem]">
        <div class="rotate-[3deg] rounded-2xl bg-white p-4 shadow-sm ring-1 ring-black/5 md:rotate-[4deg]">
          <Image
            class="h-[260px] w-full rounded-xl object-cover"
            src={image}
            width="288"
            height="288"
            alt={name}
          />
        </div>
      </figure>
    </div>
  </div>
</Section>
